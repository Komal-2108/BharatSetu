# BharatSetu Backend Configuration

# Server Setup
PROJECT_NAME="BharatSetu Hyperlocal API"
API_V1_STR="/api/v1"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security / JWT Auth
SECRET_KEY="bharatsetu_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# Database Configuration (SQLite by default, PostgreSQL/Supabase ready)
DATABASE_URL="sqlite:///./bharatsetu.db"
# PostgreSQL example: postgresql://user:password@localhost:5432/bharatsetu

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"  # Twilio Sandbox WhatsApp number

# Supabase Storage Configuration (Optional)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key-here"
SUPABASE_BUCKET="bharatsetu-media"

# Local Storage Directory for Uploads
UPLOAD_DIR="./uploads"
BASE_URL="http://localhost:8000"
